{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "group:all",
    "mergeConfidence:all-badges"
  ],
  "osvVulnerabilityAlerts": true,
  "prHourlyLimit": 0,
  "prConcurrentLimit": 40,
  "commitMessagePrefix": ":arrow_up:",
  "rebaseWhen": "conflicted",
  "schedule": ["* 22-23,0-4 * * *", "* * * * 0,6"],
  "customManagers": [
    {
      "customType": "regex",
      "fileMatch": ["\\.md$"],
      "matchStrings": [
        "<!--\\s*renovate:\\s*datasource=(?<datasource>[^\\s]+)\\s+depName=(?<depName>[^\\s]+)\\s*-->\\s*\\n[^\\n]*?(?<currentValue>\\d+\\.\\d+\\.\\d+)"
      ]
    }
  ],
  "packageRules": [
    {
      "groupName": "kotlin",
      "matchPackageNames": [
        "/androidx.compose.compiler:compiler/",
        "/org.jetbrains.kotlin.*/"
      ],
      "allowedVersions": ">=2.3.0 <2.4.0"
    },
    {
      "groupName": "kotlin",
      "matchPackageNames": ["/dev.mokkery.*/"],
      "allowedVersions": ">=3.3.0 <3.4.0"
    },
    {
      "groupName": "kotlin",
      "matchPackageNames": ["/com.github.skydoves.compose.stability.analyzer/"],
      "allowedVersions": ">=0.8.0 <0.9.0"
    },
    {
      "groupName": "kotlin",
      "matchPackageNames": ["/dev.drewhamilton.poko.*/"],
      "allowedVersions": ">=0.22.0 <0.23.0"
    },
    {
      "groupName": "compose-multiplatform",
      "matchPackageNames": [
        "/org.jetbrains.compose.*/",
        "/org.jetbrains.androidx.*/"
      ],
      "allowedVersions": ">=1.11.0 <1.12.0"
    }
  ]
}
