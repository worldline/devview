{"nodes": [{"id": "docs_guides_theming_theming_guide", "label": "Theming Guide", "file_type": "document", "source_file": "docs/guides/theming.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_guides_theming_section_derived_defaults", "label": "Section-Derived Defaults (v0.1.4+)", "file_type": "rationale", "source_file": "docs/guides/theming.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "containerColor/contentColor on Module default to the module's Section palette color so each module doesn't need to hand-pick colors; override only needed if a module requires a color outside its section's default."}, {"id": "docs_guides_theming_console_log_level_colors", "label": "Console Log Level Colors (hand-tuned LogColorScheme, not MaterialTheme-derived)", "file_type": "rationale", "source_file": "docs/guides/theming.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Unlike the rest of DevView, per-LogLevel colors are two complete hand-tuned palettes (LogColorScheme.Light/Dark) instead of MaterialTheme.colorScheme derivatives, because log-level contrast and consistency must hold regardless of the host app's brand colors."}, {"id": "docs_guides_theming_logcolorscheme_fallback", "label": "LocalLogColorScheme fallback behavior", "file_type": "rationale", "source_file": "docs/guides/theming.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "If LocalLogColorScheme is never provided, DevView logs a one-time warning and guesses Light/Dark from the ambient MaterialTheme's surface luminance rather than isSystemInDarkTheme(), because DevView's effective theme may be driven by something other than the system setting (e.g. a feature flag) \u2014 the theme actually in effect is the only reliable signal."}], 