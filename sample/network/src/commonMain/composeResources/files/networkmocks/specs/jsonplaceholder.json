            "content": {
              "application/json": {
                "examples": {
                  "default": { "externalValue": "/files/networkmocks/responses/jsonplaceholder/listUsers/listUsers-200.json" },
                  "empty": { "externalValue": "/files/networkmocks/responses/jsonplaceholder/listUsers/listUsers-200-empty.json" }
                }
              }
            }
          }
        }
      }
    },
