{
  "info": { "title": "JSONPlaceholder" },
  "servers": [
    { "url": "https://jsonplaceholder.typicode.com" }
  ],
  "paths": {
    "/users/{userId}": {
      "get": {
        "operationId": "getUser",
        "summary": "Get User by ID",
        "x-devview": { "delayMs": 500 },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "examples": {
                  "default": { "externalValue": "/files/networkmocks/responses/jsonplaceholder/getUser/getUser-200.json" }
                }
              }
            }
          },
          "404": {
            "content": {
              "application/json": {
                "examples": {
                  "default": { "externalValue": "/files/networkmocks/responses/jsonplaceholder/getUser/getUser-404.json" },
                  "detailed": { "externalValue": "/files/networkmocks/responses/jsonplaceholder/getUser/getUser-404-detailed.json" }
                }
              }
            }
          },
          "500": {
            "content": {
              "application/json": {
                "examples": {
                  "default": { "externalValue": "/files/networkmocks/responses/jsonplaceholder/getUser/getUser-500.json" }
                }
              }
            }
          }
        }
      }
    },
    "/users": {
      "get": {
        "operationId": "listUsers",
        "summary": "List All Users",
        "parameters": [
          { "name": "type", "in": "query", "example": "user" }
        ],
